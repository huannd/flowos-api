# ==========================================
# FlowOS API — Environment Variables
# ==========================================
# Copy this file to .env and fill in all values.
# Variables marked [REQUIRED] will crash the app if missing.

PORT=4000
NODE_ENV=development

# --- Database [REQUIRED] ---
DATABASE_URL="postgresql://flowos_admin:flowos_secret_password_change_me@localhost:5432/flowos_db"

# --- Auth [REQUIRED] ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=flowos_jwt_secret_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- n8n Engine ---
N8N_API_URL=http://localhost:5679
N8N_API_KEY=your_n8n_api_key_here

# --- n8n Webhook Secret [REQUIRED] ---
# Shared secret between n8n and FlowOS API for callback authentication
N8N_WEBHOOK_SECRET=flowos_webhook_secret_2026

# --- n8n Admin (for internal API calls) ---
N8N_ADMIN_EMAIL=admin@flowos.io
N8N_ADMIN_PASSWORD=FlowOS2026!

# --- Redis [REQUIRED] ---
REDIS_URL=redis://:flowos_redis_secret_password_change_me@localhost:6379

# --- Encryption [REQUIRED] ---
# Must be exactly 32 characters for AES-256-GCM
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
CREDENTIAL_ENCRYPTION_KEY=flowos_32_char_encryption_key!!!

# --- CORS ---
# Comma-separated origins. MUST be set explicitly in production.
# Default (dev): http://localhost:3000,http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Payment ---
# HMAC-SHA256 secret for payment provider webhooks (VNPay, MoMo, Stripe)
# If not set in development, signature verification is skipped.
# PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# --- Admin Seed ---
# Default admin password used during database seeding.
# If not set, uses 'FlowOS2026!' (CHANGE IN PRODUCTION!)
# ADMIN_DEFAULT_PASSWORD=FlowOS2026!
